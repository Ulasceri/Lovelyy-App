rules_version = '2';

// Lovelyy Firestore security rules.
//
// Data model
//   users/{uid}            profile: displayName, photoUrl, coupleId, pairCode, createdAt
//   pairCodes/{CODE}       a partner's one-time pairing code: ownerUid, createdAt
//   couples/{coupleId}     the shared space: members [ownerUid, joinerUid], createdAt, startDate,
//                          plus (Lovelyy Plus map, see validPlus)
//   couples/{id}/**        every shared feature (cat, notes, mood...) lives here; only the two
//                          members read it, and each collection has its own write rule below
//                          (exact fields, size limits, author = signed-in user). A new shared
//                          collection needs a new match block, or the app's writes are denied.
//   couples/{id}/limits/{uid}  signal rate limit: last signal + hourly/daily windows, server time
//
// Pairing (see android/.../data/PairingRepository.kt):
//   A creates pairCodes/CODE. B, in ONE transaction, creates couples/CODE,
//   sets coupleId on both user docs and deletes pairCodes/CODE.
//   These rules accept only that exact shape.
//
// Unpairing (see android/.../data/LeaveRepository.kt), Spark plan so no server code:
//   A in ONE batch marks the couple ended (endedAt, endedBy, endedByName) and clears
//   users/A.coupleId, then deletes every shared doc under couples/{id}/** (still a member).
//   B's app sees the ended couple, deletes what is left, clears users/B.coupleId and deletes
//   the couple doc in one batch.
//   An ended couple accepts no new shared writes, only deletes.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function couplePath(id) { return /databases/$(database)/documents/couples/$(id); }
    function codePath(code) { return /databases/$(database)/documents/pairCodes/$(code); }

    function isUnpaired(uid) {
      return exists(userPath(uid)) && get(userPath(uid)).data.get('coupleId', null) == null;
    }
    function validName(n) { return n is string && n.size() <= 40; }

    // ---------- field helpers ----------
    // Kotlin's take(n) counts UTF-16 units, which is never fewer than the characters counted here,
    // so every limit the app applies on the client also passes these checks.
    function str(v, max) { return v is string && v.size() <= max; }
    function optStr(v, max) { return v == null || str(v, max); }
    function optInt(v) { return v == null || v is int; }
    function isDay(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function authoredByMe(d) { return d.by == me() && validName(d.byName) && d.at is int; }
    function authorUnchanged() { return !changedKeys().hasAny(['by', 'byName', 'at']); }
    function editedByMe() {
      return request.resource.data.get('updatedBy', null) == me() && request.resource.data.get('updatedAt', null) is int
        && changedKeys().hasAny(['updatedAt']);
    }
    // Up to 12 short strings (rules have no loops, so each index is checked).
    function shortItems(l, max) {
      return l is list && l.size() <= 12
        && (l.size() < 1 || str(l[0], max)) && (l.size() < 2 || str(l[1], max))
        && (l.size() < 3 || str(l[2], max)) && (l.size() < 4 || str(l[3], max))
        && (l.size() < 5 || str(l[4], max)) && (l.size() < 6 || str(l[5], max))
        && (l.size() < 7 || str(l[6], max)) && (l.size() < 8 || str(l[7], max))
        && (l.size() < 9 || str(l[8], max)) && (l.size() < 10 || str(l[9], max))
        && (l.size() < 11 || str(l[10], max)) && (l.size() < 12 || str(l[11], max));
    }

    // ---------- shared feature documents (field names match the Android repositories) ----------
    function validCat(d) {
      return d.keys().hasOnly(['name', 'hunger', 'thirst', 'energy', 'love', 'sleepingSince',
                               'lastAction', 'recent', 'streak', 'wearing', 'items', 'itemsAt', 'itemsNew',
                               'sleepRefillMin'])
        && optStr(d.get('name', null), 20)
        && optStr(d.get('wearing', null), 32)
        && d.get('hunger', {}) is map && d.get('thirst', {}) is map
        && d.get('energy', {}) is map && d.get('love', {}) is map
        && d.get('streak', {}) is map
        && (d.get('lastAction', null) == null || d.lastAction is map)
        && d.get('recent', []) is list && d.get('recent', []).size() <= 10;
    }
    // Mırmır's items (CatItems / CatItemRules), inside cat/main. Every slot holds one of its own models; the free
    // ("sade") model of each slot is open to everyone, the others need an active Plus when they are newly chosen
    // (an already stored choice may stay after Plus ends; the app then shows the free model). sleepRefillMin is the
    // Plus bed's faster sleep (45 min), set when the cat lies down. d = new doc, o = old doc (or {}).
    function plusItem(id) {
      return id in ['mama_balik_tabagi', 'mama_sut', 'su_cesme', 'oyuncak_fare', 'oyuncak_tuy', 'oyuncak_tirmalama',
                    'yatak_kutu', 'yatak_sepet'];
    }
    function validItemMap(i) {
      return i is map && i.keys().hasOnly(['feed', 'water', 'play', 'sleep'])
        && i.get('feed', 'mama_sade') in ['mama_sade', 'mama_balik_tabagi', 'mama_sut']
        && i.get('water', 'su_sade') in ['su_sade', 'su_cesme']
        && i.get('play', 'oyuncak_yumak') in ['oyuncak_yumak', 'oyuncak_fare', 'oyuncak_tuy', 'oyuncak_tirmalama']
        && i.get('sleep', 'yatak_minder') in ['yatak_minder', 'yatak_kutu', 'yatak_sepet'];
    }
    function noNewPlusItems(i, o) {
      return (!plusItem(i.get('feed', '')) || i.get('feed', '') == o.get('feed', ''))
        && (!plusItem(i.get('water', '')) || i.get('water', '') == o.get('water', ''))
        && (!plusItem(i.get('play', '')) || i.get('play', '') == o.get('play', ''))
        && (!plusItem(i.get('sleep', '')) || i.get('sleep', '') == o.get('sleep', ''));
    }
    // Care writes that leave the item fields alone skip the item checks (keeps the cat rule under the
    // 1000-expression limit).
    function validItems(d, o, plus) {
      return !d.diff(o).affectedKeys().hasAny(['items', 'itemsAt', 'itemsNew', 'sleepRefillMin'])
        || validItemsChange(d, o, plus);
    }
    function validItemsChange(d, o, plus) {
      let i = d.get('items', null);
      let oi = o.get('items', null);
      let r = d.get('sleepRefillMin', null);
      return (i == null || (validItemMap(i) && (plus || noNewPlusItems(i, oi == null ? {} : oi))))
        && (d.get('itemsAt', null) == null || d.itemsAt is timestamp)
        && (d.get('itemsNew', null) == null
            || (d.itemsNew is string && d.itemsNew.size() <= 32 && d.itemsNew.matches('^[a-z_]+$')))
        && (r == null || r == 60 || (r == 45 && (plus || r == o.get('sleepRefillMin', null))));
    }
    // "2026-11" for a timestamp (UTC), to check a day-off month against the server clock.
    function monthOf(t) {
      return string(t.year()) + '-' + (t.month() < 10 ? '0' : '') + string(t.month());
    }
    // A couple day "yyyy-MM-dd" (in the couple's own zone, UTC-12..UTC+14) that can be "today" somewhere at the
    // server's time: its UTC midnight is at most 14 hours ahead and less than 36 hours behind (with some slack).
    // Parsed into a timestamp instead of formatting request.time, which costs too many rule expressions.
    function dayNearNow(d) {
      let t = timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10]));
      return t <= request.time + duration.value(1, 'd') && t > request.time - duration.value(2, 'd');
    }
    // A time the app stamped just now. The app counts time from the server clock (TrustedClock), so only a
    // phone whose clock was tampered with (or a modified app) misses this window.
    function nearNow(t) {
      return t is timestamp && t > request.time - duration.value(5, 'm') && t < request.time + duration.value(5, 'm');
    }
    // Cat times (CatRules): a need, the sleep start and the last action may only change to "now". This stops a
    // phone set hours ahead from stamping the cat in the future (needs that never decay, a 25-hour sleep).
    // o = the stored cat ({} on create).
    function catTimesOk(d, o) {
      return needTimeOk(d.get('hunger', {}), o.get('hunger', {})) && needTimeOk(d.get('thirst', {}), o.get('thirst', {}))
        && needTimeOk(d.get('energy', {}), o.get('energy', {})) && needTimeOk(d.get('love', {}), o.get('love', {}))
        && (d.get('sleepingSince', null) == null || d.sleepingSince == o.get('sleepingSince', null) || nearNow(d.sleepingSince))
        && (d.get('lastAction', null) == null || d.lastAction == o.get('lastAction', null) || nearNow(d.lastAction.get('at', null)));
    }
    function needTimeOk(n, o) {
      return n.get('at', null) == o.get('at', null) || nearNow(n.get('at', null));
    }
    function monthNearNow(m) {
      return m == monthOf(request.time) || m == monthOf(request.time + duration.value(1, 'd'))
        || m == monthOf(request.time - duration.value(1, 'd'));
    }
    // The care streak inside cat/main (CareStreak / StreakProtection). Exact keys; Lovelyy Plus streak
    // protection is checked here: days off (freezeDays) only change together with freezeUsed counting up
    // by one in the current month (or starting at 1 in a new month), at most 2 a month; made-up days
    // (repairDays) and days off need an active Plus on the couple (plusActive). s = new map, o = old map.
    function validStreak(s, o, plus) {
      return s.keys().hasOnly(['count', 'best', 'lastCompleteDay', 'careDay', 'careBy', 'freezeMonth', 'freezeUsed',
                               'freezeDays', 'repairDays', 'brokenCount', 'brokenLast'])
        && s.get('count', 0) is int && s.get('count', 0) >= 0
        && s.get('best', 0) is int && s.get('best', 0) >= 0
        && (s.get('lastCompleteDay', null) == null || isDay(s.lastCompleteDay))
        && (s.get('careDay', null) == null || isDay(s.careDay))
        && s.get('careBy', []) is list && s.get('careBy', []).size() <= 2
        && s.get('freezeUsed', 0) is int && s.get('freezeUsed', 0) >= 0 && s.get('freezeUsed', 0) <= 2
        && s.get('freezeDays', []) is list && s.get('freezeDays', []).size() <= 6
        && s.get('repairDays', []) is list && s.get('repairDays', []).size() <= 6
        && s.get('brokenCount', 0) is int && s.get('brokenCount', 0) >= 0
        && (s.get('brokenLast', null) == null || isDay(s.brokenLast))
        && (s.get('freezeMonth', null) == null || (s.freezeMonth is string && s.freezeMonth.matches('^[0-9]{4}-[0-9]{2}$')))
        && (
          // No new day off: month and count stay as they were.
          (s.get('freezeDays', []) == o.get('freezeDays', [])
            && s.get('freezeMonth', null) == o.get('freezeMonth', null)
            && s.get('freezeUsed', 0) == o.get('freezeUsed', 0))
          // A new day off: Plus, this month, one more (or the first of a new month).
          || (plus && s.get('freezeDays', []) != o.get('freezeDays', []) && monthNearNow(s.get('freezeMonth', ''))
            && ((s.freezeMonth == o.get('freezeMonth', null) && s.freezeUsed == o.get('freezeUsed', 0) + 1)
                || (s.freezeMonth != o.get('freezeMonth', null) && s.freezeUsed == 1)))
        )
        && (s.get('repairDays', []) == o.get('repairDays', []) || plus)
        // A care day only moves to a day that is "today" somewhere at the server's time (no days ahead).
        && (s.get('careDay', null) == o.get('careDay', null) || dayNearNow(s.careDay))
        && (s.get('lastCompleteDay', null) == o.get('lastCompleteDay', null) || dayNearNow(s.lastCompleteDay));
    }
    function validSignal(d, members) {
      return d.keys().hasOnly(['kind', 'emotion', 'mood', 'from', 'fromName', 'to', 'text', 'at', 'createdAt'])
        && d.kind in ['heartbeat', 'nudge', 'mood', 'question', 'note', 'event', 'wheel']
        && d.from == me() && d.to != me() && d.to in members
        && validName(d.fromName)
        && optStr(d.get('emotion', null), 20)
        && optStr(d.get('mood', null), 20)
        && optStr(d.get('text', null), 120)
        && d.at is int
        && d.createdAt == request.time;
    }
    // A fixed rate-limit window: either a new window starting now (only once the old one is over)
    // or one more in the current window, never above max. Counting up in an expired window is
    // allowed too (only stricter), so a phone with a wrong clock can always fall back to it.
    function windowOk(d, old, startKey, countKey, length, max) {
      return d[countKey] is int && d[countKey] <= max && (
        (d[startKey] == request.time && d[countKey] == 1
          && (old == null || !(startKey in old) || request.time >= old[startKey] + length))
        || (old != null && startKey in old && countKey in old
          && d[startKey] == old[startKey] && d[countKey] == old[countKey] + 1)
      );
    }
    // Limits come from config/limits (editable in the Firebase console, no app update needed):
    // signalsPerHour, signalsPerDay, minGapSeconds. Missing doc or field = the defaults below.
    function signalConfig() {
      let p = /databases/$(database)/documents/config/limits;
      return exists(p) ? get(p).data : {};
    }
    function validLimits(d, old) {
      let cfg = signalConfig();
      return d.keys().hasOnly(['signalAt', 'hourStart', 'hourCount', 'dayStart', 'dayCount'])
        && d.signalAt == request.time
        && (old == null || !('signalAt' in old)
            || request.time > old.signalAt + duration.value(cfg.get('minGapSeconds', 2), 's'))
        && windowOk(d, old, 'hourStart', 'hourCount', duration.value(1, 'h'), cfg.get('signalsPerHour', 15))
        && windowOk(d, old, 'dayStart', 'dayCount', duration.value(24, 'h'), cfg.get('signalsPerDay', 60));
    }
    function validMood(d) {
      return d.keys().hasOnly(['kind', 'note', 'at']) && str(d.kind, 20) && str(d.note, 140) && d.at is int;
    }
    function validMoodLog(d) {
      return d.keys().hasOnly(['kind', 'note', 'at', 'uid', 'day'])
        && str(d.kind, 20) && str(d.note, 140) && d.at is int && d.uid == me() && isDay(d.day);
    }
    // old = the answers map before this write. Mine is added or changed, nobody else's is touched,
    // and once both of us answered mine is locked (same rule as QuestionMath.isLocked).
    function validQuestion(d, old) {
      return d.keys().hasOnly(['question', 'answers', 'updatedAt', 'day'])
        && str(d.question, 300)
        && d.updatedAt == request.time
        && d.answers is map
        && d.answers.diff(old).affectedKeys().hasOnly([me()])
        && validAnswer(d.answers[me()])
        && !(me() in old && old.size() > 1);
    }
    function validAnswer(a) {
      return a is map && a.keys().hasOnly(['name', 'text', 'at']) && validName(a.name) && str(a.text, 500) && a.at is int;
    }
    function validNote(d) {
      return d.keys().hasOnly(['text', 'color', 'pinned', 'by', 'byName', 'at', 'updatedAt', 'updatedBy'])
        && str(d.text, 1000) && d.color is int && d.color >= 0 && d.color < 5 && d.pinned is bool
        && optInt(d.get('updatedAt', null)) && optStr(d.get('updatedBy', null), 128);
    }
    function validEvent(d) {
      return d.keys().hasOnly(['title', 'date', 'emoji', 'yearly', 'by', 'byName', 'at', 'updatedAt', 'updatedBy'])
        && str(d.title, 60) && isDay(d.date) && str(d.emoji, 32) && d.yearly is bool
        && optInt(d.get('updatedAt', null)) && optStr(d.get('updatedBy', null), 128);
    }
    function validDream(d) {
      return d.keys().hasOnly(['title', 'category', 'goal', 'by', 'byName', 'at', 'doneAt', 'updatedAt', 'updatedBy'])
        && str(d.title, 80) && d.category in ['seyahat', 'deneyim', 'hayat', 'diger'] && str(d.goal, 40)
        && optInt(d.get('doneAt', null))
        && optInt(d.get('updatedAt', null)) && optStr(d.get('updatedBy', null), 128);
    }
    function validLocation(d) {
      return d.keys().hasOnly(['city', 'lat', 'lng', 'cityOnly', 'at'])
        && str(d.city, 60)
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.cityOnly is bool && d.at is int;
    }
    function validWheel(d) {
      return d.keys().hasOnly(['label', 'items', 'at']) && str(d.label, 24) && shortItems(d.items, 20) && d.at is int;
    }
    function validSpin(d) {
      return d.keys().hasOnly(['label', 'result', 'by', 'byName', 'at', 'wheelId'])
        && str(d.label, 24) && str(d.result, 20) && validName(d.byName) && d.at is int;
    }
    function validCapsule(d) {
      return d.keys().hasOnly(['title', 'text', 'openOn', 'by', 'byName', 'at'])
        && str(d.title, 60) && str(d.text, 4000) && isDay(d.openOn);
    }
    function validStroke(d) {
      return d.keys().hasOnly(['by', 'color', 'width', 'points', 'at'])
        && d.color is int && d.width is number && d.width > 0 && d.width <= 1
        && d.points is list && d.points.size() <= 1000 && d.at is int;
    }
    function validSavedDrawing(d) {
      return d.keys().hasOnly(['strokes', 'by', 'byName', 'at']) && d.strokes is list && d.strokes.size() <= 600;
    }

    // ---------- users ----------
    match /users/{userId} {
      // B is allowed to set A's coupleId only while creating their shared couple.
      function joiningCouple() {
        let cid = request.resource.data.get('coupleId', null);
        return resource.data.get('coupleId', null) == null
          && cid is string
          && !exists(couplePath(cid))
          && existsAfter(couplePath(cid))
          && getAfter(couplePath(cid)).data.members.hasAll([userId, me()]);
      }
      function coupleUnchanged() {
        return request.resource.data.get('coupleId', null) == resource.data.get('coupleId', null);
      }
      function validPairCode() {
        let code = request.resource.data.get('pairCode', null);
        return code == null
          || code == resource.data.get('pairCode', null)
          || (existsAfter(codePath(code)) && getAfter(codePath(code)).data.ownerUid == userId);
      }
      // Leaving: my couple is gone or marked ended (in the same write).
      function leavingCouple() {
        let cid = resource.data.get('coupleId', null);
        return cid != null
          && request.resource.data.get('coupleId', null) == null
          && (!existsAfter(couplePath(cid)) || getAfter(couplePath(cid)).data.get('endedAt', null) != null);
      }
      function isPartner() {
        let cid = resource.data.get('coupleId', null);
        return cid != null && me() in get(couplePath(cid)).data.members;
      }

      allow get: if signedIn() && (me() == userId || isPartner());
      allow list: if false;

      allow create: if signedIn() && me() == userId
        && request.resource.data.keys().hasOnly(['displayName', 'photoUrl', 'coupleId', 'pairCode', 'createdAt'])
        && validName(request.resource.data.displayName)
        && optStr(request.resource.data.get('photoUrl', null), 1000)
        && request.resource.data.get('coupleId', null) == null
        && request.resource.data.get('pairCode', null) == null
        && request.resource.data.createdAt == request.time;

      // Myself: edit my profile, my pairing code, and join a couple.
      allow update: if signedIn() && me() == userId
        && request.resource.data.keys().hasOnly(['displayName', 'photoUrl', 'coupleId', 'pairCode', 'createdAt'])
        && request.resource.data.createdAt == resource.data.createdAt
        && validName(request.resource.data.displayName)
        && optStr(request.resource.data.get('photoUrl', null), 1000)
        && validPairCode()
        && (coupleUnchanged() || joiningCouple() || leavingCouple());

      // My partner-to-be: only links me to our new couple and clears my code.
      allow update: if signedIn() && me() != userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coupleId', 'pairCode'])
        && request.resource.data.get('pairCode', null) == null
        && joiningCouple();

      // Deleting my account: only once I'm no longer in a couple.
      allow delete: if signedIn() && me() == userId && resource.data.get('coupleId', null) == null;
    }

    // ---------- config ----------
    // App-wide settings edited only in the Firebase console (e.g. config/limits). Readable by any
    // signed-in user so the app can show the same limits; never writable from the app.
    match /config/{docId} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    // ---------- pairCodes ----------
    match /pairCodes/{code} {
      // Knowing the code is the secret. Single reads only, never listing.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && code.matches('^[A-HJKMNP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt'])
        && request.resource.data.ownerUid == me()
        && request.resource.data.createdAt == request.time
        && isUnpaired(me())
        && !exists(couplePath(code));

      allow update: if false;

      // The owner can retire it; the partner deletes it while creating the couple.
      allow delete: if signedIn() && (
        resource == null
        || resource.data.ownerUid == me()
        || (existsAfter(couplePath(code)) && me() in getAfter(couplePath(code)).data.members)
      );
    }

    // ---------- couples ----------
    match /couples/{coupleId} {
      function isMember() { return signedIn() && me() in resource.data.members; }

      function validNewCouple() {
        let d = request.resource.data;
        let codeDoc = get(codePath(coupleId));
        let owner = codeDoc.data.ownerUid;
        return d.keys().hasOnly(['members', 'createdAt', 'startDate'])
          && d.members is list && d.members.size() == 2
          && d.members[0] == owner
          && d.members[1] == me()
          && owner != me()
          && request.time < codeDoc.data.createdAt + duration.value(24, 'h')
          && d.createdAt == request.time
          && d.get('startDate', null) == null
          && isUnpaired(owner) && isUnpaired(me())
          && !existsAfter(codePath(coupleId))
          && getAfter(userPath(owner)).data.coupleId == coupleId
          && getAfter(userPath(me())).data.coupleId == coupleId;
      }

      function isEnded() { return resource.data.get('endedAt', null) != null; }

      // Lovelyy Plus (data/Plus.kt, PlusRepository): one map for both partners. Written by the members'
      // phones (no server on the Spark plan), so this only checks shape and the few rules that matter:
      // the trial start is set once near the server time and never moves; only the buyer (the signed-in
      // member written as buyerUid) can change what was bought. Client-written entitlement is an accepted
      // launch risk, see docs/security.md.
      function validPlus(p, old) {
        return p is map
          && p.keys().hasOnly(['trialStart', 'until', 'source', 'product', 'buyerUid', 'autoRenew', 'orderToken', 'giftNote'])
          && p.get('trialStart', null) is int
          && ((old == null && math.abs(p.trialStart - request.time.toMillis()) <= 86400000)
              || (old != null && p.trialStart == old.get('trialStart', null)))
          && p.get('source', 'trial') in ['trial', 'sub', 'gift']
          && optInt(p.get('until', null))
          && optStr(p.get('product', null), 64)
          && (p.get('buyerUid', null) == null || p.buyerUid in resource.data.members)
          && (p.get('autoRenew', null) == null || p.autoRenew is bool)
          && optStr(p.get('orderToken', null), 512)
          && optStr(p.get('giftNote', null), 140)
          && ((old == null && p.get('source', 'trial') == 'trial' && p.get('until', null) == null)
              || (old != null && p.diff(old).affectedKeys().size() == 0)
              || p.get('buyerUid', null) == me());
      }

      allow get, list: if isMember();
      allow create: if signedIn() && validNewCouple();
      // Day counter start date (an ended couple has endedAt, so it never passes hasOnly).
      allow update: if isMember()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['members', 'createdAt', 'plus'])
        && request.resource.data.keys().hasOnly(['members', 'createdAt', 'startDate', 'plus'])
        && (request.resource.data.get('startDate', null) == null || request.resource.data.startDate is timestamp);
      // Lovelyy Plus: trial start, purchases, restore, takeover (not on an ended couple).
      allow update: if isMember() && !isEnded()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plus'])
        && validPlus(request.resource.data.plus, resource.data.get('plus', null));
      // Ending the couple: once, by a member, stamped with the server time and their own uid.
      allow update: if isMember() && !isEnded()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endedAt', 'endedBy', 'endedByName'])
        && request.resource.data.endedAt == request.time
        && request.resource.data.endedBy == me()
        && validName(request.resource.data.endedByName);
      // The partner who stayed removes the ended couple when leaving it.
      allow delete: if isMember() && isEnded();

      // ---------- shared features: couples/{id}/** ----------
      // Only the two members read or delete anything here (unpairing deletes everything, so
      // deletes stay open to both). Writes are allowed per collection only, with the exact
      // fields the app writes, size limits, the author bound to the signed-in user and author
      // fields immutable. A collection that is not listed below cannot be written at all.
      // After the couple ended nothing new is written, it can only be deleted.
      function coupleData() { return get(couplePath(coupleId)).data; }
      function isMemberHere() { return signedIn() && me() in coupleData().members; }
      function openCouple() { return isMemberHere() && coupleData().get('endedAt', null) == null; }
      function limitPath() { return /databases/$(database)/documents/couples/$(coupleId)/limits/$(me()); }

      // ({sub}/ is required: a bare {document=**} would also match the couple doc itself.)
      match /{sub}/{document=**} {
        allow read, delete: if isMemberHere();
      }

      // The couple has Lovelyy Plus right now (same rules as PlusRules.isPlus: the 14-day trial, or a paid
      // period with 3 days of grace while it auto-renews). Server time, so a phone's clock can't extend it.
      function plusActive() {
        let p = coupleData().get('plus', null);
        let now = request.time.toMillis();
        return p != null && (
          (p.get('trialStart', null) is int && now < p.trialStart + 14 * 86400000)
          || (p.get('source', 'trial') != 'trial' && p.get('until', null) is int
              && (now < p.until || (p.get('autoRenew', false) == true && now < p.until + 3 * 86400000)))
        );
      }

      // The Plus-dependent parts of a cat write, with plusActive() evaluated once.
      function catPlusOk(d, o, plus) {
        return validStreak(d.get('streak', {}), o.get('streak', {}), plus) && validItems(d, o, plus);
      }

      // cat/main (CatRepository). Written as a whole doc in a transaction, or merged for "wearing".
      // The streak map is checked against the stored one (days off / make-up need Plus, see validStreak).
      match /cat/{docId} {
        allow create, update: if openCouple() && docId == 'main' && validCat(request.resource.data)
          && catTimesOk(request.resource.data, resource == null ? {} : resource.data)
          && catPlusOk(request.resource.data, resource == null ? {} : resource.data, plusActive());
      }

      // signals/{auto} (SignalRepository.send): heartbeat, nudge and "I did something" notices.
      // Rate limited: each send also stamps limits/{me}.signalAt in the same batch (see below).
      match /signals/{id} {
        allow create: if openCouple()
          && validSignal(request.resource.data, coupleData().members)
          && getAfter(limitPath()).data.get('signalAt', null) == request.time;
      }

      // limits/{uid}: my signal rate limit, all in server time. Defaults: one signal every 2 seconds,
      // 15 per hour, 60 per day per person; overridden by config/limits (see signalConfig).
      match /limits/{uid} {
        allow create, update: if openCouple() && uid == me()
          && validLimits(request.resource.data, resource == null ? null : resource.data);
      }

      // moods/{uid}: my current mood. moodLog/{uid}_{day}: my last mood of that day.
      match /moods/{uid} {
        allow create, update: if openCouple() && uid == me() && validMood(request.resource.data);
      }
      match /moodLog/{id} {
        allow create, update: if openCouple() && validMoodLog(request.resource.data) && id == me() + '_' + request.resource.data.day;
      }

      // questions/{yyyy-MM-dd}: I can only write my own answer, and not after both of us answered.
      match /questions/{day} {
        allow create, update: if openCouple() && isDay(day)
          && validQuestion(request.resource.data, resource == null ? {} : resource.data.get('answers', {}));
      }

      // notes, events (plans), dreams: anyone of us edits, the author fields never change and
      // a content edit is stamped with the editor's own uid.
      match /notes/{id} {
        allow create: if openCouple() && validNote(request.resource.data) && authoredByMe(request.resource.data);
        allow update: if openCouple() && validNote(request.resource.data) && authorUnchanged()
          && (!changedKeys().hasAny(['text', 'color', 'updatedAt', 'updatedBy']) || editedByMe());
      }
      match /events/{id} {
        allow create: if openCouple() && validEvent(request.resource.data) && authoredByMe(request.resource.data);
        allow update: if openCouple() && validEvent(request.resource.data) && authorUnchanged() && editedByMe();
      }
      match /dreams/{id} {
        allow create: if openCouple() && validDream(request.resource.data) && authoredByMe(request.resource.data);
        allow update: if openCouple() && validDream(request.resource.data) && authorUnchanged()
          && (!changedKeys().hasAny(['title', 'category', 'goal', 'updatedAt', 'updatedBy']) || editedByMe());
      }

      // locations/{uid}: only my own (already rounded) location.
      match /locations/{uid} {
        allow create, update: if openCouple() && uid == me() && validLocation(request.resource.data);
      }

      // Decision wheel: custom wheels, the last spin of each wheel and the spin history.
      match /wheels/{id} {
        allow create, update: if openCouple() && validWheel(request.resource.data);
      }
      match /wheelSpins/{wheelId} {
        allow create, update: if openCouple() && validSpin(request.resource.data) && request.resource.data.by == me();
      }
      match /wheelLog/{id} {
        allow create: if openCouple() && validSpin(request.resource.data) && request.resource.data.by == me()
          && str(request.resource.data.wheelId, 100);
      }

      // capsules/{auto}: time capsule letters. Written once, never edited.
      match /capsules/{id} {
        allow create: if openCouple() && validCapsule(request.resource.data) && authoredByMe(request.resource.data);
      }

      // Live drawing: strokes on the canvas, who is drawing now, and drawings saved to Anılar.
      match /strokes/{id} {
        allow create: if openCouple() && validStroke(request.resource.data) && request.resource.data.by == me();
      }
      match /drawing/{docId} {
        allow create, update: if openCouple() && docId == 'presence'
          && request.resource.data.keys().hasOnly(coupleData().members)
          && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly([me()])
          && request.resource.data[me()] is int;
      }
      match /drawings/{id} {
        allow create: if openCouple() && id.matches('^d_.+') && validSavedDrawing(request.resource.data)
          && authoredByMe(request.resource.data);
      }

      // settings/main: the couple's shared time zone (CoupleClock).
      // clock/{uid} (ClockSync): the app writes the server time here and reads it back to learn how far its own
      // clock is off. Only the server time, only mine.
      match /clock/{uid} {
        allow create, update: if openCouple() && uid == me()
          && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
      }

      match /settings/{docId} {
        allow create, update: if openCouple() && docId == 'main'
          && request.resource.data.keys().hasOnly(['zone', 'setBy', 'at'])
          && str(request.resource.data.zone, 64)
          && request.resource.data.setBy == me()
          && request.resource.data.at == request.time;
      }
    }
  }
}
