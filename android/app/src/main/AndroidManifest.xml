<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Heartbeats and nudges from the partner: notification + heartbeat vibration. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Mesafe: only a rough (city level) location, only while the user shares it. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".LovelyyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Lovelyy.Starting">

        <!-- Telemetry: off until the app reads the user's choice at startup (TelemetryConsent),
             which then turns collection on or off and Firebase remembers it. See docs/analytics.md. -->
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="false" />
        <meta-data android:name="firebase_performance_collection_enabled" android:value="false" />
        <!-- Screen views come from the app's own state (one activity), not automatic activity tracking. -->
        <meta-data android:name="google_analytics_automatic_screen_reporting_enabled" android:value="false" />
        <!-- Never collect the advertising id: this app shows no ads. -->
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home-screen widget showing the cat's current mood. -->
        <receiver
            android:name=".widget.CatWidgetProvider"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cat_widget_info" />
        </receiver>

        <!-- More home-screen widgets (approved design 15). -->
        <receiver
            android:name=".widget.CatWideWidgetProvider"
            android:exported="false"
            android:label="@string/widget_wide_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cat_wide_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.DaysWidgetProvider"
            android:exported="false"
            android:label="@string/widget_days_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/days_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.DrawingWidgetProvider"
            android:exported="false"
            android:label="@string/widget_drawing_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/drawing_widget_info" />
        </receiver>
        <!-- Redraws widgets and refreshes the notification channel text when the language changes. -->
        <receiver
            android:name=".widget.LocaleChangedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- The days widget's heart button. -->
        <receiver
            android:name=".widget.HeartReceiver"
            android:exported="false" />
    </application>
</manifest>
