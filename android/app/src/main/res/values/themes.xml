<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base window theme. All real styling happens in Compose (ui/theme). -->
    <style name="Theme.Lovelyy" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Shown for a split second while the app starts. -->
    <style name="Theme.Lovelyy.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cream</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Lovelyy</item>
    </style>
</resources>
