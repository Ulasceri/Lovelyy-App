<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wide_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_cream"
    android:clipToOutline="true"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/wide_cat"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.45"
        android:background="#FAE2C0"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/cat_w_idle" />

    <LinearLayout
        android:id="@+id/wide_info"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.55"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/wide_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/quicksand_bold"
                android:maxLines="1"
                android:textColor="@color/brown"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/wide_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip_peach"
                android:fontFamily="@font/quicksand_bold"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="@color/brown"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/quicksand_bold"
                android:text="@string/need_hunger"
                android:textColor="@color/brown"
                android:textSize="12sp" />
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="7dp"
                android:layout_weight="1">
                <ProgressBar
                    android:id="@+id/wide_hunger_ok"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_bar_ok" />
                <ProgressBar
                    android:id="@+id/wide_hunger_low"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_bar_low"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/quicksand_bold"
                android:text="@string/need_thirst"
                android:textColor="@color/brown"
                android:textSize="12sp" />
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="7dp"
                android:layout_weight="1">
                <ProgressBar
                    android:id="@+id/wide_thirst_ok"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_bar_ok" />
                <ProgressBar
                    android:id="@+id/wide_thirst_low"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_bar_low"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/quicksand_bold"
                android:text="@string/need_energy"
                android:textColor="@color/brown"
                android:textSize="12sp" />
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="7dp"
                android:layout_weight="1">
                <ProgressBar
                    android:id="@+id/wide_energy_ok"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_bar_ok" />
                <ProgressBar
                    android:id="@+id/wide_energy_low"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_bar_low"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/quicksand_bold"
                android:text="@string/need_love"
                android:textColor="@color/brown"
                android:textSize="12sp" />
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="7dp"
                android:layout_weight="1">
                <ProgressBar
                    android:id="@+id/wide_love_ok"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_bar_ok" />
                <ProgressBar
                    android:id="@+id/wide_love_low"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_bar_low"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/wide_couple"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/quicksand_bold"
            android:maxLines="1"
            android:textColor="@color/brown"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Shown instead of wide_info when the couple has no Plus (CatWidget.renderWide). -->
    <LinearLayout
        android:id="@+id/wide_locked"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.55"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_plus_pill"
            android:fontFamily="@font/quicksand_bold"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/plus_pill"
            android:textColor="@color/cream"
            android:textSize="12sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:text="@string/plus_widget_locked"
            android:textColor="@color/brown"
            android:textSize="16sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/quicksand_semibold"
            android:gravity="center"
            android:text="@string/plus_widget_locked_sub"
            android:textColor="@color/brown_soft"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
