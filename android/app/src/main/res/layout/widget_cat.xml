<?xml version="1.0" encoding="utf-8"?>
<!-- Small cat widget (approved design 15 · "Kedi · küçük"): name chip top-left, what the cat says at the bottom. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_cream"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_cat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAE2C0"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/cat_w_idle" />

    <TextView
        android:id="@+id/widget_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="@drawable/widget_pill"
        android:fontFamily="@font/quicksand_bold"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textColor="@color/brown"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="10dp"
        android:background="@drawable/widget_bubble"
        android:ellipsize="end"
        android:fontFamily="@font/quicksand_bold"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:textColor="@color/brown"
        android:textSize="13sp" />
</FrameLayout>
