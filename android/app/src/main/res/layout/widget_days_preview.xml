<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/days_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_cream"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <FrameLayout
        android:layout_width="74dp"
        android:layout_height="44dp">
        <TextView
            android:id="@+id/days_me"
            android:text="U"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_avatar_peach"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:textColor="@color/brown"
            android:textSize="17sp" />
        <TextView
            android:id="@+id/days_partner"
            android:text="E"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="30dp"
            android:background="@drawable/widget_avatar_mint"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:textColor="@color/brown"
            android:textSize="17sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand_bold"
            android:text="@string/widget_together"
            android:textColor="#75655E"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/days_count"
            android:text="@string/widget_days_sample"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand_bold"
            android:maxLines="1"
            android:textColor="@color/brown"
            android:textSize="22sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/days_heart"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/widget_heart_bg"
        android:contentDescription="@string/widget_send_heart"
        android:padding="13dp"
        android:src="@drawable/widget_heart" />
</LinearLayout>
